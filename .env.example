# Database — PostgreSQL connection string (e.g. Neon: postgresql://user:pass@host/db?sslmode=require)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pasha_academy"

# Public site URL — used for canonical URLs, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Long random string used to sign session tokens (openssl rand -base64 48)
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Initial admin account created by `npm run db:seed`
ADMIN_EMAIL="admin@pasha-academy.com"
ADMIN_PASSWORD="Admin@12345"

# Where uploaded documents are stored (outside /public so they are never publicly served)
UPLOAD_DIR="./storage/uploads"

# Vercel: connect a PRIVATE Blob store (never a public store for student documents).
BLOB_READ_WRITE_TOKEN=""
# Random secret, minimum 32 characters; authenticates daily temporary-upload cleanup.
CRON_SECRET=""
