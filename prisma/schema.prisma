// Pasha Academy data model.
// PostgreSQL everywhere (Neon / Vercel Postgres in production, local Postgres or a Neon branch in dev).

generator client {
  provider = "prisma-client-js"
}

model RateLimit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  /// STUDENT | AGENT | ADMIN
  role         String   @default("STUDENT")
  /// Only for agents: PENDING | APPROVED | SUSPENDED
  agentStatus  String?
  companyName  String?
  city         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownApplications   Application[] @relation("StudentApplications")
  agentApplications Application[] @relation("AgentApplications")
}

model University {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  nameEn      String
  city        String
  /// PUBLIC | PRIVATE
  type        String
  founded     Int?
  students    Int?
  tuitionFrom Int?
  /// Comma separated, e.g. "ترکی,انگلیسی"
  languages   String
  /// Comma separated faculty / program names
  programs    String
  summary     String
  description String
  website     String?
  /// Logo image: absolute URL or a path under /public, e.g. /images/universities/koc.png
  logo        String?
  color       String   @default("#0B2A4A")
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applications Application[]
  offerings    Program[]
}

model Application {
  id           String   @id @default(cuid())
  /// Human friendly tracking code, e.g. PA-7K2Q9M
  code         String   @unique
  /// DORMITORY | ADMISSION
  type         String
  /// SUBMITTED | IN_REVIEW | NEEDS_ACTION | APPROVED | REJECTED
  status       String   @default("SUBMITTED")

  studentName  String
  motherName   String?
  studentEmail String
  studentPhone String
  nationality  String
  passportNo   String?
  birthDate    String?

  universityId String?
  university   University? @relation(fields: [universityId], references: [id], onDelete: SetNull)
  program      String?
  degree       String?
  /// Pasha Academy scholarship quota used for this application (percent off tuition), null = none
  scholarshipPercent Int?

  dormCity     String?
  roomType     String?
  moveInDate   String?

  notes        String?
  adminNote    String?

  studentId    String?
  student      User?    @relation("StudentApplications", fields: [studentId], references: [id], onDelete: SetNull)
  agentId      String?
  agent        User?    @relation("AgentApplications", fields: [agentId], references: [id], onDelete: SetNull)

  documents    Document[]
  events       ApplicationEvent[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([studentId])
  @@index([agentId])
}

model Document {
  id            String   @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  /// See DOC_KINDS in src/lib/constants.ts
  kind          String
  originalName  String
  storedName    String   @unique
  mimeType      String
  size          Int
  /// PENDING | APPROVED | REJECTED
  status        String   @default("PENDING")
  reviewNote    String?
  reviewedAt    DateTime?
  createdAt     DateTime @default(now())

  @@index([applicationId])
}

model ApplicationEvent {
  id            String   @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  message       String
  actor         String
  createdAt     DateTime @default(now())

  @@index([applicationId])
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  service   String?
  message   String?
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

/// A study program with its tuition. Prices are USD.
model Program {
  id               String     @id @default(cuid())
  universityId     String
  university       University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  name             String
  nameEn           String?
  faculty          String?
  /// ASSOCIATE | BACHELOR | MASTER | PHD
  degree           String
  /// TR | EN
  language         String
  durationYears    Int
  /// Yearly tuition when paying term by term
  tuition          Int
  /// Discounted total when the whole course is paid upfront to the university
  cashTotal        Int?
  deposit          Int?
  /// Yearly fee of the preparatory language year (0 = not needed / free)
  prepFee          Int?
  /// Total price of a Pasha Academy 100% scholarship seat for the whole course (null = no scholarship seat)
  scholarshipPrice Int?
  active           Boolean    @default(true)
  /// Placeholder data shown with a sample label until real prices are imported
  sample           Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([universityId])
  @@index([degree])
  @@index([tuition])
}
